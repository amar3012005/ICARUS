{
  "name": "singulance-amr",
  "version": "0.1.1",
  "description": "SINGULANCE AMR — a memory filesystem for AI agents. Per-tenant mmap'd vector + temporal + graph store in the .amr format. Drop-in for Qdrant.",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "icarus": "mneme-cli.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "native.js",
    "mneme-cli.js",
    "cli-lib.js",
    "mcp-serve.js",
    "mcp-install.js",
    "daemon.js",
    "graph.js",
    "graph-native.js",
    "*.node",
    "README.md"
  ],
  "napi": {
    "name": "singulance-amr",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "scripts": {
    "build": "napi build --release",
    "build:debug": "napi build",
    "prepublishOnly": "napi prepublish -t npm --skip-gh-release"
  },
  "keywords": [
    "vector-database",
    "memory",
    "embeddings",
    "hnsw",
    "ai-agents",
    "mmap",
    "qdrant-alternative",
    "vector-search",
    "singulance"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amar3012005/ICARUS.git",
    "directory": "crate/mneme-node"
  },
  "homepage": "https://github.com/amar3012005/ICARUS",
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  },
  "optionalDependencies": {
    "singulance-amr-darwin-arm64": "0.1.0",
    "singulance-amr-darwin-x64": "0.1.0",
    "singulance-amr-linux-arm64-gnu": "0.1.0",
    "singulance-amr-linux-x64-gnu": "0.1.0",
    "singulance-amr-win32-x64-msvc": "0.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8",
    "zod": "^4.4.3"
  }
}
