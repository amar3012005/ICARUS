{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "icarus-telemetry",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "icarus-telemetry",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
